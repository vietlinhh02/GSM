# GSM Voice Backend Environment Configuration

# Server address to bind
APP_ADDR=127.0.0.1:8080

# PostgreSQL connection parameters (used by both Docker Compose and the backend application)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=gsmvoicee
POSTGRES_PASSWORD=gsmvoicee_dev_secret
POSTGRES_DB=gsmvoicee
POSTGRES_SSLMODE=disable

# Optional: Full connection URL override (if set, takes precedence over POSTGRES_* parameters)
# DATABASE_URL=postgres://gsmvoicee:gsmvoicee_dev_secret@127.0.0.1:5433/gsmvoicee?sslmode=disable
